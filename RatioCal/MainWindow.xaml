<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RatioCal"
        mc:Ignorable="d"
        Title="RatioCal" Height="255" Width="400" Background="Black" ResizeMode="CanMinimize">
    <Grid>
        <Image x:Name="IMG_bg" Source="/Akane Icon 576.png"/>
        <TextBlock x:Name="TB_w2" Text="Width" Foreground="Black" HorizontalAlignment="Left" Margin="42,80,0,0"/>
        <TextBlock x:Name="TB_h2" Text="Height" Foreground="Black" HorizontalAlignment="Left" Margin="40,130,0,0"/>
        <Button x:Name="B_cal" Content="Cal" Margin="0,140,0,0" Height="20" Width="70" Click="Button_Click"/>
        <Button x:Name="B_bg" Content="BG" Margin="0,59,350,129" Click="Button_BG"/>
        <TextBox x:Name="TB_h" Text="" Width="70" Height="20" Margin="-100,60,0,0"/>
        <TextBox x:Name="TB_w" Text="" Width="70" Height="20" Margin="-100,-40,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox x:Name="TB_r1" Text="16" Width="70" Height="20" Margin="-300,190,0,0"/>
        <TextBox x:Name="TB_r2" Text="9" Width="70" Height="20" Margin="-100,190,0,0"/>
        <Label x:Name="T_tip" Content="Fun Fact: 4:3 = 16:12" Foreground="White" Margin="263,190,0,0" Background="Black"/>
    </Grid>
</Window>
